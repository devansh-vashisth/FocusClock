# ─── Server ─────────────────────────────────────────────────────────────────
# Port the Express server listens on (defaults to 5000 if not set)
PORT=5000

# ─── Database ────────────────────────────────────────────────────────────────
# Full MongoDB connection URI.
# Example (local):  mongodb://localhost:27017/focusclock
# Example (Atlas):  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/focusclock?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/focusclock

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example: http://localhost:5173,https://focusclock.app
CLIENT_ORIGIN=http://localhost:5173
